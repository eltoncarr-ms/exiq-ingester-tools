{
  "CosmosCleanup": {
    "AccountEndpoint": "https://exiqsqldb.documents.azure.com:443/",
    "DatabaseName": "exiq",
    "Containers": [
      {
        "Name": "interactions-v1",
        "PartitionKeyPaths": [
          "/tenantId",
          "/userId"
        ]
      },
      {
        "Name": "snapshots-v1",
        "PartitionKeyPaths": [
          "/tenantId",
          "/userId"
        ]
      }
    ],
    "PartitionDeleteConcurrency": 4,
    "PartitionDeleteRetryAttempts": 120,
    "PartitionDeleteRetryDelaySeconds": 5,
    "VerificationAttempts": 10,
    "VerificationDelaySeconds": 2
  }
}
