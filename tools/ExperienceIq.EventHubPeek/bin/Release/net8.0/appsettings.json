{
  "EventHub": {
    "FullyQualifiedNamespace": "exiq-portal-data.servicebus.windows.net",
    "EventHubName": "exiq-events",
    "ConsumerGroup": "$Default",
    "CheckpointStorageAccountName": "exiqstorage",
    "CheckpointContainerName": "exiq-checkpoints"
  },
  "Peek": {
    "IdleSeconds": 5,
    "MaxEvents": 100000,
    "BodyPreview": 1000,
    "ForceReadEmptyPartitions": true,
    "OutputPath": null,
    "Clear": false,
    "Quiet": true,
    "ShowConsumerGroupState": true
  }
}
