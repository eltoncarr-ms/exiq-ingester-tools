{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experienceiq/ingester/lifecycle-config.schema.json",
  "title": "Event lifecycle ingestion configuration",
  "type": "object",
  "required": [ "schemaVersion", "lifecycles" ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventHubRetention": { "type": "string" },
        "snapshotInterval": { "type": "string" },
        "flush": { "$ref": "#/$defs/flushPolicy" }
      }
    },
    "lifecycles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycle" }
    }
  },
  "$defs": {
    "selector": {
      "type": "string",
      "pattern": "^\\$(\\.[A-Za-z0-9_]+|\\[[0-9]+\\]|\\['[^']+'\\])*$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "version", "sessionKeySelector", "eventTypeSelector", "eventKeySelector", "partSelector", "parts", "flush", "output" ],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typeEquals": { "type": "string" },
            "selectorExists": { "$ref": "#/$defs/selector" },
            "selectorEquals": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "selector", "value" ],
              "properties": {
                "selector": { "$ref": "#/$defs/selector" },
                "value": {}
              }
            }
          }
        },
        "sessionKeySelector": { "$ref": "#/$defs/selector" },
        "eventTypeSelector": { "$ref": "#/$defs/selector" },
        "eventKeySelector": { "$ref": "#/$defs/selector" },
        "partSelector": { "$ref": "#/$defs/selector" },
        "prioritySelector": { "$ref": "#/$defs/selector" },
        "timestampSelector": { "$ref": "#/$defs/selector" },
        "dedupeKeySelector": { "$ref": "#/$defs/selector" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "name", "required" ],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "allowDuplicates": { "type": "boolean", "default": false },
              "order": { "type": "integer" }
            }
          }
        },
        "flush": { "$ref": "#/$defs/flushPolicy" },
        "output": { "$ref": "#/$defs/output" }
      }
    },
    "flushPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whenRequiredPartsPresent": { "type": "boolean", "default": true },
        "partialAfterRetentionFraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "partialAfterMax": { "type": "string" },
        "priorityImmediately": { "type": "boolean", "default": true },
        "updateAfterPartial": { "type": "boolean", "default": true },
        "maxUpdates": { "type": "integer", "minimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "container", "schemaVersion", "idTemplate", "partitionKeyTemplate", "payloadMappings" ],
      "properties": {
        "container": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "idTemplate": { "type": "string" },
        "partitionKeyTemplate": { "type": "string" },
        "writeMode": { "enum": [ "upsert", "patch", "auto" ], "default": "auto" },
        "ttlSeconds": { "type": "integer", "minimum": -1 },
        "payloadMappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "target" ],
            "properties": {
              "target": { "type": "string" },
              "sourcePart": { "type": "string" },
              "source": { "$ref": "#/$defs/selector" },
              "constant": {},
              "required": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
