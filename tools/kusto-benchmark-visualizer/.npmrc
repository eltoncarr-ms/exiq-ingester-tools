# Use the ExperienceIQ Azure Artifacts feed. Its npmjs.org upstream keeps
# dependency downloads on the repository's audited package path.
registry=https://pkgs.dev.azure.com/msazure/One/_packaging/ExperienceIQ-Consumption/npm/registry/
always-auth=true

# Refuse installs when the package's declared Node engine is not satisfied.
engine-strict=true

# Keep npm cache metadata local to this tool to avoid cross-feed contamination.
cache=.npm-cache
