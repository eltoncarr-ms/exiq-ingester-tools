{
  "name": "kusto-benchmark-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side visualization for Kusto-direct ExIQ ingestion benchmark artifacts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
